btn.MouseButton1Click:Connect(function()
    local key = keyBox.Text:gsub("%s+", "")
    if key == "" then
        status.Text = "❌ Введи ключ!"
        status.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    status.Text = "⏳ Подключение к серверу..."
    status.TextColor3 = Color3.fromRGB(255, 200, 50)
    btn.Text = "..."
    btn.BackgroundColor3 = Color3.fromRGB(0, 150, 80)
    local hwid = tostring(Players.LocalPlayer.UserId)
    local nonce = tostring(math.random(100000, 999999))
    local authUrl = BASE_URL .. "/auth?key=" .. key .. "&hwid=" .. hwid .. "&nonce=" .. nonce .. "&script=" .. SCRIPT_ID
    local success, response = pcall(function() return game:HttpGet(authUrl) end)
    if not success then
        status.Text = "❌ Ошибка сети. Сервер недоступен."
        status.TextColor3 = Color3.fromRGB(255, 80, 80)
        btn.Text = "АВТОРИЗАЦИЯ"
        btn.BackgroundColor3 = Color3.fromRGB(0, 255, 136)
        return
    end
    local data = HttpService:JSONDecode(response)
    if data.ok then
        status.Text = "✅ Успешно! Загрузка..."
        status.TextColor3 = Color3.fromRGB(0, 255, 136)
        _G.VesselAuth = { session = data.session_id, nonce = nonce, base_url = BASE_URL }
        task.wait(0.5)
        local s, scriptCode = pcall(function() return game:HttpGet(data.script_url) end)
        if s then
            local loadSuccess, err = pcall(function() loadstring(scriptCode)() end)
            if loadSuccess then
                gui:Destroy()
            else
                status.Text = "❌ Ошибка в коде: " .. tostring(err)
                status.TextColor3 = Color3.fromRGB(255, 80, 80)
            end
        else
            status.Text = "❌ Не удалось скачать скрипт."
            status.TextColor3 = Color3.fromRGB(255, 80, 80)
        end
    else
        status.Text = "❌ Ошибка: " .. tostring(data.reason)
        status.TextColor3 = Color3.fromRGB(255, 80, 80)
        btn.Text = "АВТОРИЗАЦИЯ"
        btn.BackgroundColor3 = Color3.fromRGB(0, 255, 136)
    end
end)
